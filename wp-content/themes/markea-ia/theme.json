{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "navy", "color": "#001B71", "name": "Navy" },
				{ "slug": "electric", "color": "#0049FF", "name": "Blue electric" },
				{ "slug": "white", "color": "#FFFFFF", "name": "White" },
				{ "slug": "cyan", "color": "#56E1E9", "name": "Cyan" },
				{ "slug": "purple", "color": "#BB63FF", "name": "Purple" },
				{ "slug": "indigo", "color": "#5B58EB", "name": "Indigo" },
				{ "slug": "dark", "color": "#0D0D2B", "name": "Dark" }
			]
		},
		"typography": {
			"customFontSize": false,
			"fluid": false,
			"fontFamilies": [
				{ "slug": "heading", "name": "Montserrat", "fontFamily": "'Montserrat Variable', 'Montserrat', system-ui, sans-serif" },
				{ "slug": "body", "name": "Poppins", "fontFamily": "'Poppins', system-ui, -apple-system, 'Segoe UI', sans-serif" }
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Small" },
				{ "slug": "base", "size": "1rem", "name": "Base" },
				{ "slug": "lead", "size": "clamp(1.125rem, 1.5vw, 1.375rem)", "name": "Lead" },
				{ "slug": "h3", "size": "clamp(1.25rem, 2vw, 1.5rem)", "name": "H3" },
				{ "slug": "h2", "size": "clamp(1.75rem, 1.2rem + 1.5vw, 2.5rem)", "name": "H2" },
				{ "slug": "h1", "size": "clamp(2.5rem, 7vw, 5rem)", "name": "H1" }
			]
		},
		"spacing": {
			"spacingSizes": [
				{ "slug": "s", "size": "1rem", "name": "S" },
				{ "slug": "m", "size": "2rem", "name": "M" },
				{ "slug": "l", "size": "clamp(3rem, 8vw, 6rem)", "name": "L" }
			]
		},
		"layout": { "contentSize": "720px", "wideSize": "1200px" }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--navy)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--base)", "lineHeight": "1.6" }
	}
}
